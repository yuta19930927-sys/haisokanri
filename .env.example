# Copy this file to .env.local and fill in your Supabase project values.
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----- /api/ai-daily-check（Claudeの毎朝チェック用API）: Vercel の環境変数にだけ設定する -----
# ※ VITE_ を付けないこと（付けると画面側のJSに埋め込まれて外部に漏れます）
AI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# T-LINK の tenants.id（テナントが1社だけなら省略可）
AI_TENANT_ID=
